# Backend Service Environment Variables
# Copy this file to .env and fill in the real values

# --- Strapi ---
STRAPI_URL=http://localhost:1337
# Optional comma-separated UID allowlist. Leave blank to use all authorized
# dynamic content-type discoveries; static Article/Blog targets are the fallback.
STRAPI_IMPORT_COLLECTIONS=
# API token with create + read permissions for selected content types.
# Article media uploads also require Upload:create.
STRAPI_API_TOKEN=your_strapi_api_token_here

# --- Strapi Admin JWT (optional) ---
# Required for dynamic discovery, schema creation, and approved additive schema changes.
# How to obtain: Sign in to Strapi Admin → open DevTools → Network tab →
# look for any API call → copy the "Authorization: Bearer <jwt>" value.
# This is a personal user JWT, NOT the API token above.
# ⚠ Keep this secret. Never commit it. Rotate after use.
# Approved Content-Type Builder updates are only available when Strapi exposes the
# update route (development mode). Leave blank to use static discovery fallback.
STRAPI_ADMIN_JWT=

# --- Gemini AI ---
# Get a free key at https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Service ---
PORT=3001
# Simple auth key — the Svelte frontend sends this header: X-Import-Key
IMPORT_API_KEY=change_me_local_dev_only
